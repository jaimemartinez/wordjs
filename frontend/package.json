{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:editor": "npm run build -w @wordjs/puck",
    "predev": "npm run build:editor && node scripts/generate-plugin-registry.js && node scripts/generate-admin-plugin-registry.js && node scripts/generate-puck-plugin-registry.js",
    "prebuild": "npm run build:editor && node scripts/generate-plugin-registry.js && node scripts/generate-admin-plugin-registry.js && node scripts/generate-puck-plugin-registry.js",
    "dev": "node scripts/start-frontend.js dev",
    "build": "next build",
    "start": "node scripts/start-frontend.js prod",
    "lint": "eslint .",
    "test": "vitest run",
    "generate-plugins": "node scripts/generate-plugin-registry.js && node scripts/generate-admin-plugin-registry.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@editorjs/editorjs": "^2.31.1",
    "@editorjs/header": "^2.8.8",
    "@editorjs/image": "^2.10.3",
    "@editorjs/list": "^2.0.9",
    "@editorjs/paragraph": "^2.11.7",
    "@editorjs/quote": "^2.7.6",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-bubble-menu": "^3.27.1",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-image": "^3.15.3",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@wordjs/puck": "*",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "editorjs-html": "^4.0.5",
    "editorjs-text-color-plugin": "^2.0.4",
    "next": "^16.1.1",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.8",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-simple-wysiwyg": "^3.4.1",
    "recharts": "^3.7.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "postcss": "^8.5.10"
  }
}
