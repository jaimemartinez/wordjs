{
    "id": "photo-carousel",
    "name": "Photo Carousel",
    "version": "2.0.1",
    "description": "Create and manage image carousels with admin UI",
    "author": "WordJS",
    "isolated": true,
    "backend": {
        "entry": "index.js"
    },
    "frontend": {
        "components": [
            {
                "name": "HeroCarousel",
                "entry": "client/components/HeroCarousel.tsx",
                "locations": [
                    "hero"
                ],
                "props": {
                    "carousel": "object"
                }
            }
        ],
        "adminPage": {
            "entry": "client/admin/page.tsx",
            "slug": "carousels"
        },
        "versoComponents": {
            "entry": "client/verso/PhotoCarouselVerso.tsx"
        }
    },
    "api": {
        "baseUrl": "/api/v1/carousels",
        "endpoints": [
            "list",
            "get",
            "create",
            "update",
            "delete"
        ]
    },
    "shortcodes": [
        {
            "tag": "carousel",
            "requiredAttrs": [
                "id"
            ]
        }
    ],
    "adminMenu": {
        "label": "Carousels",
        "icon": "fa-images",
        "href": "/admin/plugin/carousels",
        "order": 50
    },
    "permissions": [
        {
            "scope": "browser",
            "access": "script",
            "reason": "Run the plugin's own compiled interface in the browser: its admin page, its Verso block (in the editor and on public pages) and its site components. Without it the host does not serve these bundles and that interface does not load."
        },
        {
            "scope": "settings",
            "access": "read",
            "reason": "Required to read carousel configurations."
        },
        {
            "scope": "settings",
            "access": "write",
            "reason": "Required to create and update carousel data."
        },
        {
            "scope": "database",
            "access": "write",
            "reason": "Required to save carousel configurations and image metadata."
        },
        {
            "scope": "express",
            "access": "register_route",
            "reason": "Expose the admin CRUD endpoints and the public carousel data the block and the [carousel] shortcode consume."
        },
        {
            "scope": "admin_menu",
            "access": "register",
            "reason": "Add the Photo Carousel entry to the admin sidebar."
        }
    ],
    "dependencies": {
        "uuid": "^10.0.0"
    }
}
