{
    "id": "faq",
    "name": "FAQ",
    "version": "1.0.1",
    "description": "Database-managed FAQ with categories, publish toggles and drag-free reordering, rendered by the Verso block \"Faq\" as an accordion. Unlike the core static Accordion block, it emits Google FAQPage structured data (JSON-LD) so your questions qualify for rich results in search.",
    "author": "WordJS",
    "isolated": true,
    "backend": {
        "entry": "index.js"
    },
    "frontend": {
        "adminPage": {
            "entry": "client/admin/page.tsx",
            "slug": "faq"
        },
        "versoComponents": {
            "entry": "client/verso/FaqVerso.tsx"
        }
    },
    "themeSurfaces": [
        {
            "element": "wrap",
            "selector": ".wjs-p-faq-wrap"
        },
        {
            "element": "title",
            "selector": ".wjs-p-faq-title"
        },
        {
            "element": "item",
            "selector": ".wjs-p-faq-item",
            "children": {
                "open": { "selector": ".wjs-p-faq-item--open" },
                "question": { "selector": ".wjs-p-faq-question" },
                "icon": { "selector": ".wjs-p-faq-icon" },
                "iconOpen": { "selector": ".wjs-p-faq-item--open .wjs-p-faq-icon" },
                "panel": { "selector": ".wjs-p-faq-panel" },
                "answer": { "selector": ".wjs-p-faq-answer" }
            }
        },
        {
            "element": "empty",
            "selector": ".wjs-p-faq-empty"
        }
    ],
    "adminMenu": {
        "label": "FAQ",
        "icon": "fa-circle-question",
        "href": "/admin/plugin/faq",
        "order": 63
    },
    "permissions": [
        {
            "scope": "browser",
            "access": "script",
            "reason": "Run the plugin's own compiled interface in the browser: its admin page and its Verso block (in the editor and on public pages). Without it the host does not serve these bundles and that interface does not load."
        },
        {
            "scope": "database",
            "access": "read",
            "reason": "Read the FAQ entries and their categories."
        },
        {
            "scope": "database",
            "access": "write",
            "reason": "Create the plugin's FAQ table and insert/update/reorder/delete entries."
        },
        {
            "scope": "express",
            "access": "register_route",
            "reason": "Expose the admin CRUD endpoints and the public FAQ list the Puck block consumes."
        },
        {
            "scope": "admin_menu",
            "access": "register",
            "reason": "Add the FAQ entry to the admin sidebar."
        }
    ]
}
