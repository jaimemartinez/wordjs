{
    "id": "card-gallery",
    "name": "Card Gallery",
    "version": "1.0.1",
    "description": "Manage event promo cards with zigzag layout",
    "author": "WordJS",
    "isolated": true,
    "backend": {
        "entry": "index.js"
    },
    "frontend": {
        "components": [
            {
                "name": "PromoCards",
                "entry": "client/components/PromoCards.tsx",
                "locations": [
                    "cards"
                ],
                "props": {}
            }
        ],
        "adminPage": {
            "entry": "client/admin/page.tsx",
            "slug": "cards"
        },
        "versoComponents": {
            "entry": "client/verso/CardGalleryVerso.tsx"
        }
    },
    "api": {
        "baseUrl": "/api/v1/cards",
        "endpoints": [
            "list",
            "get",
            "create",
            "update",
            "delete"
        ]
    },
    "shortcodes": [
        {
            "tag": "cards",
            "requiredAttrs": []
        }
    ],
    "adminMenu": {
        "label": "Card Gallery",
        "icon": "fa-id-card",
        "href": "/admin/plugin/cards",
        "order": 55
    },
    "permissions": [
        {
            "scope": "browser",
            "access": "script",
            "reason": "Run the plugin's own compiled interface in the browser: its admin page, its Verso block (in the editor and on public pages) and its site components. Without it the host does not serve these bundles and that interface does not load."
        },
        {
            "scope": "settings",
            "access": "read",
            "reason": "Required to read gallery list and configurations."
        },
        {
            "scope": "settings",
            "access": "write",
            "reason": "Required to create and update gallery data."
        },
        {
            "scope": "database",
            "access": "write",
            "reason": "Required to save and manage promo cards."
        },
        {
            "scope": "express",
            "access": "register_route",
            "reason": "Expose the admin CRUD endpoints and the public gallery list the block consumes."
        },
        {
            "scope": "admin_menu",
            "access": "register",
            "reason": "Add the Card Gallery entry to the admin sidebar."
        }
    ],
    "dependencies": {
        "uuid": "^10.0.0"
    }
}
