{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "pb-brand",
        "align": "center",
        "gap": "sm",
        "items": [
          { "type": "ChromeSiteTitle", "props": { "id": "pb-title", "showTagline": true } }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "pb-navrow",
        "align": "center",
        "gap": "lg",
        "wrap": true,
        "items": [
          { "type": "ChromeNav", "props": { "id": "pb-nav", "location": "header", "orientation": "horizontal" } }
        ]
      }
    }
  ]
}
