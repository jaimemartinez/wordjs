{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "nd-footer-row",
        "align": "between",
        "gap": "lg",
        "wrap": true,
        "items": [
          { "type": "ChromeSiteTitle", "props": { "id": "nd-footer-title", "showTagline": false } },
          { "type": "ChromeNav", "props": { "id": "nd-footer-nav", "location": "footer", "orientation": "horizontal" } },
          { "type": "ChromeSocials", "props": { "id": "nd-footer-socials", "source": "settings" } }
        ]
      }
    }
  ]
}
