{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "ps-foot-cols",
        "align": "between",
        "gap": "lg",
        "wrap": true,
        "items": [
          {
            "type": "ChromeRow",
            "props": {
              "id": "ps-col-brand",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeSiteTitle", "props": { "id": "ps-brand", "showTagline": true } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "ps-col-nav",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeText", "props": { "id": "ps-h-nav", "text": "Navegación" } },
                { "type": "ChromeNav", "props": { "id": "ps-fnav", "location": "footer", "orientation": "vertical" } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "ps-col-social",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeText", "props": { "id": "ps-h-social", "text": "Síguenos" } },
                { "type": "ChromeSocials", "props": { "id": "ps-social", "source": "settings" } }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "ps-foot-bottom",
        "align": "between",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeText", "props": { "id": "ps-copy", "text": "Todos los derechos reservados." } },
          { "type": "ChromeText", "props": { "id": "ps-made", "text": "Hecho con WordJS" } }
        ]
      }
    }
  ]
}
