{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "sc-foot-cols",
        "align": "between",
        "gap": "lg",
        "wrap": true,
        "items": [
          {
            "type": "ChromeRow",
            "props": {
              "id": "sc-col-brand",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeSiteTitle", "props": { "id": "sc-brand", "showTagline": true } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "sc-col-nav",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeText", "props": { "id": "sc-h-nav", "text": "Explorar" } },
                { "type": "ChromeNav", "props": { "id": "sc-fnav", "location": "footer", "orientation": "vertical" } }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "sc-foot-bottom",
        "align": "between",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeText", "props": { "id": "sc-copy", "text": "Respira. Todo llega." } },
          { "type": "ChromeSocials", "props": { "id": "sc-social", "source": "settings" } }
        ]
      }
    }
  ]
}
