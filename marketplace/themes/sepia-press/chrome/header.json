{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "sp-masthead",
        "align": "between",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeLogo", "props": { "id": "sp-logo", "size": "md" } },
          { "type": "ChromeSearch", "props": { "id": "sp-search", "placeholder": "Buscar en la revista…" } }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "sp-sections",
        "align": "start",
        "gap": "lg",
        "wrap": true,
        "items": [
          { "type": "ChromeNav", "props": { "id": "sp-nav", "location": "header", "orientation": "horizontal" } }
        ]
      }
    }
  ]
}
