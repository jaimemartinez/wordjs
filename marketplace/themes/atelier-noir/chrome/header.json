{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "an-h-brand",
        "align": "center",
        "gap": "md",
        "items": [
          { "type": "ChromeLogo", "props": { "id": "an-h-logo", "size": "lg" } }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "an-h-rule",
        "align": "center",
        "gap": "sm",
        "items": [
          { "type": "ChromeSpacer", "props": { "id": "an-h-gap", "size": "md" } }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "an-h-nav",
        "align": "center",
        "gap": "lg",
        "wrap": true,
        "items": [
          { "type": "ChromeNav", "props": { "id": "an-h-menu", "location": "header", "orientation": "horizontal" } }
        ]
      }
    }
  ]
