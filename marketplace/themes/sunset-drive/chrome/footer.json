{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "sd-f-cols",
        "align": "between",
        "gap": "lg",
        "wrap": true,
        "items": [
          {
            "type": "ChromeRow",
            "props": {
              "id": "sd-f-c1",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeSiteTitle", "props": { "id": "sd-f-title", "showTagline": true } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "sd-f-c2",
              "align": "center",
              "gap": "sm",
              "items": [
                { "type": "ChromeNav", "props": { "id": "sd-f-menu", "location": "footer", "orientation": "vertical" } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "sd-f-c3",
              "align": "end",
              "gap": "md",
              "items": [
                { "type": "ChromeSocials", "props": { "id": "sd-f-social", "source": "settings" } }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "sd-f-gap",
        "align": "center",
        "gap": "sm",
        "items": [
          { "type": "ChromeSpacer", "props": { "id": "sd-f-s", "size": "lg" } }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "sd-f-sign",
        "align": "center",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeText", "props": { "id": "sd-f-copy", "text": "Sunset Drive Records — neon nights since 1987" } }
        ]
      }
    }
  ]
}
