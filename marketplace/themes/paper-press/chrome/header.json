        "items": [
          { "type": "ChromeText", "props": { "id": "pp-edition", "text": "EDICIÓN DE HOY" } },
          { "type": "ChromeText", "props": { "id": "pp-since", "text": "INDEPENDIENTE DESDE 1998" } }
