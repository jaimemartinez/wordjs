{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "cc-footer-grid",
        "align": "start",
        "gap": "lg",
        "wrap": true,
        "items": [
          {
            "type": "ChromeRow",
            "props": {
              "id": "cc-footer-c1",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeSiteTitle", "props": { "id": "cc-footer-title", "showTagline": true } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "cc-footer-c2",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeNav", "props": { "id": "cc-footer-nav", "location": "footer", "orientation": "vertical" } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "cc-footer-c3",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeSearch", "props": { "id": "cc-footer-search", "placeholder": "Buscar en el sitio" } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "cc-footer-c4",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeSocials", "props": { "id": "cc-footer-socials", "source": "settings" } }
              ]
            }
          }
        ]
      }
    },
    { "type": "ChromeSpacer", "props": { "id": "cc-footer-gap", "size": "lg" } },
    {
      "type": "ChromeRow",
      "props": {
        "id": "cc-footer-legal",
        "align": "between",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeText", "props": { "id": "cc-legal-note", "text": "Todos los derechos reservados." } },
          {
            "type": "ChromeRow",
            "props": {
              "id": "cc-legal-links",
              "align": "end",
              "gap": "sm",
              "items": [
                { "type": "ChromeButton", "props": { "id": "cc-legal-privacy", "label": "Privacidad", "href": "/privacidad", "variant": "ghost" } },
                { "type": "ChromeButton", "props": { "id": "cc-legal-terms", "label": "Aviso legal", "href": "/aviso-legal", "variant": "ghost" } }
              ]
            }
          }
        ]
      }
    }
  ]
}
