{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "ct-footer-status",
        "align": "between",
        "gap": "md",
        "items": [
          {
            "type": "ChromeRow",
            "props": {
              "id": "ct-footer-brand",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeText", "props": { "id": "ct-footer-prompt", "text": "~$" } },
                { "type": "ChromeSiteTitle", "props": { "id": "ct-footer-title", "showTagline": true } }
              ]
            }
          },
          { "type": "ChromeSocials", "props": { "id": "ct-footer-socials", "source": "settings" } }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "ct-footer-cols",
        "align": "start",
        "gap": "lg",
        "wrap": true,
        "items": [
          {
            "type": "ChromeRow",
            "props": {
              "id": "ct-footer-col-nav",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeNav", "props": { "id": "ct-footer-nav", "location": "footer", "orientation": "vertical" } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "ct-footer-col-search",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeSearch", "props": { "id": "ct-footer-search", "placeholder": "grep the archive" } }
              ]
            }
          }
        ]
      }
    }
  ]
}
