{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "jh-mark",
        "align": "center",
        "gap": "sm",
        "items": [
          { "type": "ChromeSiteTitle", "props": { "id": "jh-title", "showTagline": true } }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "jh-column",
        "align": "center",
        "gap": "md",
        "items": [
          { "type": "ChromeNav", "props": { "id": "jh-fnav", "location": "footer", "orientation": "vertical" } }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "jh-social",
        "align": "center",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeSocials", "props": { "id": "jh-fsocial", "source": "settings" } }
        ]
      }
    }
  ]
}
