{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "vs-foot-cols",
        "align": "between",
        "gap": "lg",
        "wrap": true,
        "items": [
          {
            "type": "ChromeRow",
            "props": {
              "id": "vs-col-brand",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeSiteTitle", "props": { "id": "vs-brand", "showTagline": true } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "vs-col-nav",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeText", "props": { "id": "vs-h-nav", "text": "Estudio" } },
                { "type": "ChromeNav", "props": { "id": "vs-fnav", "location": "footer", "orientation": "vertical" } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "vs-col-address",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeText", "props": { "id": "vs-h-addr", "text": "Dirección" } },
                { "type": "ChromeText", "props": { "id": "vs-addr", "text": "Calle del Taller, 12\n28004 Madrid\nLunes a viernes, 9–18h" } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "vs-col-social",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeText", "props": { "id": "vs-h-social", "text": "Redes" } },
                { "type": "ChromeSocials", "props": { "id": "vs-social", "source": "settings" } }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "vs-foot-bottom",
        "align": "between",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeText", "props": { "id": "vs-copy", "text": "Arquitectura y paisaje" } },
          { "type": "ChromeText", "props": { "id": "vs-made", "text": "Hecho con WordJS" } }
        ]
      }
    }
  ]
}
