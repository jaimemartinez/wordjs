      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "aw-deptbar",
        "align": "between",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeNav", "props": { "id": "aw-nav", "location": "header", "orientation": "horizontal" } },
          { "type": "ChromeText", "props": { "id": "aw-promise", "text": "Piezas hechas a mano en el taller" } }
        ]
      }
    }
  ]
