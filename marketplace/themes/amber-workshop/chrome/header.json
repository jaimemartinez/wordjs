{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "aw-brandbar",
        "align": "between",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeLogo", "props": { "id": "aw-logo", "size": "md" } },
          { "type": "ChromeButton", "props": { "id": "aw-cta", "label": "Encargos", "href": "/contacto", "variant": "primary" } }
