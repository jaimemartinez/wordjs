{
  "root": { "props": {} },
  "content": [
    {
      "type": "ChromeRow",
      "props": {
        "id": "no-f-cols",
        "align": "between",
        "gap": "lg",
        "wrap": true,
        "items": [
          {
            "type": "ChromeRow",
            "props": {
              "id": "no-f-brand",
              "align": "start",
              "gap": "sm",
              "items": [
                { "type": "ChromeSiteTitle", "props": { "id": "no-f-title", "showTagline": true } }
              ]
            }
          },
          {
            "type": "ChromeRow",
            "props": {
              "id": "no-f-menu-col",
              "align": "end",
              "gap": "lg",
              "items": [
                { "type": "ChromeNav", "props": { "id": "no-f-menu", "location": "footer", "orientation": "vertical" } }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "no-f-gap",
        "align": "center",
        "gap": "sm",
        "items": [
          { "type": "ChromeSpacer", "props": { "id": "no-f-s", "size": "lg" } }
        ]
      }
    },
    {
      "type": "ChromeRow",
      "props": {
        "id": "no-f-base",
        "align": "between",
        "gap": "md",
        "wrap": true,
        "items": [
          { "type": "ChromeText", "props": { "id": "no-f-copy", "text": "Noir & Or — Club privé · admisión por invitación" } },
          { "type": "ChromeSocials", "props": { "id": "no-f-social", "source": "settings" } }
        ]
      }
    }
  ]
}
