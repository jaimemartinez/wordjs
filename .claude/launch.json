{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "wordjs-mono",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev:mono"],
            "port": 3000,
            "env": { "WORDJS_HTTP": "1" }
        },
        {
            "name": "wordjs-mono-prod",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "start:mono"],
            "port": 3000,
            "env": { "WORDJS_HTTP": "1" }
        },
        {
            "name": "verso-dock-drill",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "-p", "3005"],
            "port": 3005
        }
    ]
}
