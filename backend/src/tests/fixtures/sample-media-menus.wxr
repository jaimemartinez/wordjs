<?xml version="1.0" encoding="UTF-8"?>
<!-- Media + navigation-menu WXR fixture for wxr-import.test.ts.

     __ORIGIN__ is replaced at runtime with the origin of the test's OWN http.createServer, so the media
     pass exercises a real download without ever touching the network. The third attachment points at a
     fixed https loopback address instead, so the egress guard's resolved-IP check is exercised too — it
     must be refused in every mode, including the one where the http opt-in is on. -->
<rss version="2.0"
     xmlns:excerpt="http://wordpress.org/export/1.2/excerpt/"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:wfw="http://wellformedweb.org/CommentAPI/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:wp="http://wordpress.org/export/1.2/">
<channel>
	<title>Media Fixture Blog</title>
	<link>https://media.fixture.example</link>
	<description>Attachments and menus</description>
	<wp:wxr_version>1.2</wp:wxr_version>
	<wp:base_site_url>https://media.fixture.example</wp:base_site_url>
	<wp:base_blog_url>https://media.fixture.example</wp:base_blog_url>

	<wp:option>
		<wp:option_name><![CDATA[nav_menu_locations]]></wp:option_name>
		<wp:option_value><![CDATA[{"primary":"500"}]]></wp:option_value>
	</wp:option>

	<wp:category>
		<wp:term_id>300</wp:term_id>
		<wp:category_nicename><![CDATA[guides]]></wp:category_nicename>
		<wp:category_parent><![CDATA[]]></wp:category_parent>
		<wp:cat_name><![CDATA[Guides]]></wp:cat_name>
		<wp:category_description><![CDATA[]]></wp:category_description>
	</wp:category>

	<wp:term>
		<wp:term_id>500</wp:term_id>
		<wp:term_taxonomy><![CDATA[nav_menu]]></wp:term_taxonomy>
		<wp:term_slug><![CDATA[main-menu]]></wp:term_slug>
		<wp:term_name><![CDATA[Main Menu]]></wp:term_name>
		<wp:term_description><![CDATA[The header menu]]></wp:term_description>
	</wp:term>

