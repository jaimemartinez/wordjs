<?xml version="1.0" encoding="UTF-8"?>
<!-- HOSTILE media WXR fixture for wxr-import.test.ts — everything a third party's export can name that
     the importer must not take at face value.

     __ORIGIN__ is replaced at runtime with the origin of the test's OWN http.createServer, exactly as in
     sample-media-menus.wxr. This file is imported AFTER that one, so `2025/01/photo.jpg` is already a
     real, stored attachment when these items arrive:

       · `hostile-collide`  — a DIFFERENT source URL (`other.jpg`) whose `_wp_attached_file` names the
                              path that attachment already holds. Its bytes must not land on top of it.
       · `hostile-dotdir`   — `_wp_attached_file` inside a dot-directory: `.derivatives/` is the image
                              negotiation cache, served with `Cache-Control: immutable`.
       · `hostile-plant`    — an ordinary post carrying the importer's OWN idempotency keys, which the
                              next run would index and believe.
       · `hostile-puck`     — a block-builder page whose image URL lives in `_puck_data`, not in the body.
-->
<rss version="2.0"
     xmlns:excerpt="http://wordpress.org/export/1.2/excerpt/"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:wfw="http://wellformedweb.org/CommentAPI/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:wp="http://wordpress.org/export/1.2/">
<channel>
	<title>Hostile Fixture Blog</title>
	<link>https://hostile.fixture.example</link>
	<description>Attachments that name paths they do not own</description>
	<wp:wxr_version>1.2</wp:wxr_version>
	<wp:base_site_url>https://hostile.fixture.example</wp:base_site_url>
	<wp:base_blog_url>https://hostile.fixture.example</wp:base_blog_url>

