<?xml version="1.0" encoding="UTF-8"?>
<!-- CHAINED-RENAME media WXR fixture for wxr-import.test.ts.

     The rename map core/wxr-import applies on top of the base URL swap draws its VALUES from the same
     namespace as its KEYS, so one file's disambiguation can be another file's original name. This
     fixture is the ordinary export that produces exactly that: WordPress mints `chain-1.jpg` itself once
     `chain.jpg` exists, so a site carrying both is not hostile at all — and the test seeds
     `2025/05/chain.jpg` on disk first, so the target install already holds the name the first item asks
     for. The plan is then

         2025/05/chain.jpg   -> 2025/05/chain-1.jpg
         2025/05/chain-1.jpg -> 2025/05/chain-1-1.jpg

     and applying those as two sequential substring swaps sends every reference to attachment A onto
     attachment B's bytes: the WRONG image behind a live URL, not a 404 anyone would notice.

     __ORIGIN__ is replaced at runtime with the origin of the test's OWN http.createServer, exactly as in
     sample-media-menus.wxr. The posts come BEFORE the attachments, which is the ordinary WXR ordering
     and the reason placements are planned up front.

       · `chain-post-a`     — references `chain.jpg`, in the body and in the excerpt.
       · `chain-post-b`     — references `chain-1.jpg`, the name item A is about to be moved to.
       · `chain-post-edges` — three references that are NOT the ones being moved: `chain.jpg.bak` (a
                              longer path this one is a prefix of), `my-chain.jpg` (a longer file name)
                              and the same path on a host the base swap does not own.
       · `chain-puck`       — the same cascade reached through a `_puck_data` string leaf.
-->
<rss version="2.0"
     xmlns:excerpt="http://wordpress.org/export/1.2/excerpt/"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:wfw="http://wellformedweb.org/CommentAPI/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:wp="http://wordpress.org/export/1.2/">
<channel>
	<title>Chained Rename Blog</title>
	<link>https://chain.fixture.example</link>
	<description>Two attachments whose disambiguations collide</description>
	<wp:wxr_version>1.2</wp:wxr_version>
	<wp:base_site_url>https://chain.fixture.example</wp:base_site_url>
	<wp:base_blog_url>https://chain.fixture.example</wp:base_blog_url>

