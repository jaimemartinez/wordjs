{
  "name": "wordjs",
  "version": "1.14.0",
  "description": "WordPress-like CMS built with Node.js and SQLite",
  "main": "src/index.ts",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=./src -r ./scripts/dev-env.js -r ts-node/register src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-force-exit -r ts-node/register src/tests/*.test.ts",
    "test:integration": "node --test --test-force-exit -r ts-node/register src/tests-integration/*.test.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "cms",
    "wordpress",
    "nodejs",
    "sqlite",
    "rest-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "acme-client": "^5.4.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "adm-zip": "^0.6.0",
    "bayes": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "css-tree": "3.2.1",
    "dnsbl": "^4.0.2",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "fast-xml-parser": "^5.10.1",
    "file-type": "^16.5.4",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "http-proxy": "^1.18.1",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.0",
    "node-forge": "^1.3.3",
    "nodemailer": "^9.0.1",
    "pg": "^8.17.1",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.0",
    "sanitize-html": "^2.17.5",
    "selfsigned": "^5.5.0",
    "semver": "^7.7.3",
    "sharp": "^0.35.3",
    "slugify": "^1.6.6",
    "smtp-server": "^3.18.0",
    "sql.js": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "nodemailer": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.5.0",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/semver": "^7.7.1",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
