{
  "name": "wordjs",
  "version": "2.7.0",
  "description": "WordPress-like CMS built with Node.js and SQLite",
  "main": "src/index.ts",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=./src -r ./scripts/dev-env.js -r ts-node/register src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node ../scripts/test-with-flake-retry.mjs --test-force-exit --test-concurrency=1 -r ts-node/register/transpile-only src/tests/*.test.ts",
    "test:coverage": "c8 --reporter=text-summary --reporter=lcov --all --src src --exclude \"src/tests/**\" --exclude \"src/tests-integration/**\" --exclude \"src/**/*.d.ts\" npm test",
    "test:coverage:check": "c8 --check-coverage --lines 80 --branches 0 --functions 0 --statements 0 --reporter=text-summary --reporter=lcov --all --src src --exclude \"src/tests/**\" --exclude \"src/tests-integration/**\" --exclude \"src/**/*.d.ts\" npm test",
    "test:coverage:report": "c8 report --check-coverage --lines 80 --branches 0 --functions 0 --statements 0 --reporter=text-summary --reporter=lcov --all --src src --exclude \"src/tests/**\" --exclude \"src/tests-integration/**\" --exclude \"src/**/*.d.ts\"",
    "test:integration": "node ../scripts/test-with-flake-retry.mjs --test-force-exit -r ts-node/register src/tests-integration/*.test.ts",
    "test:multinode": "node ../scripts/test-with-flake-retry.mjs --test-force-exit -r ts-node/register src/tests-integration/multinode-coherence.integration.ts",
    "verify:f0": "node -r ts-node/register scripts/verify-f0-baseline.ts",
    "verify:f1": "node -r ts-node/register scripts/verify-f1-content-schema.ts",
    "generate:f2": "node -r ts-node/register scripts/generate-f2-contracts.ts",
    "verify:f2": "npm run generate:f2 && node -r ts-node/register scripts/verify-f2-contracts.ts",
    "verify:f3": "node -r ts-node/register scripts/verify-f3-transactional-content.ts",
    "verify:f4": "node -r ts-node/register scripts/verify-f4-extensible-revisions.ts",
    "generate:f5": "node ../scripts/generate-visual-contract.mjs",
    "verify:f5": "node ../scripts/generate-visual-contract.mjs --check && node -r ts-node/register scripts/verify-f5-visual-contract.ts",
    "verify:f6": "node -r ts-node/register scripts/verify-f6-migration.ts",
    "pack:plugin": "node scripts/pack-plugin.js",
    "perf:f0": "node -r ts-node/register scripts/f0-content-bench.ts --enforce",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "cms",
    "wordpress",
    "nodejs",
    "sqlite",
    "rest-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "acme-client": "^5.4.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "adm-zip": "^0.6.1",
    "bayes": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "css-tree": "3.2.1",
    "dnsbl": "^4.0.3",
    "dotenv": "^18.0.7",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^21.3.4",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.1",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "http-proxy": "^1.18.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.38",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "node-forge": "^1.3.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "sanitize-html": "^2.18.0",
    "selfsigned": "^5.5.0",
    "semver": "^7.7.3",
    "sharp": "^0.35.5",
    "slugify": "^1.6.6",
    "smtp-server": "^3.19.21",
    "sql.js": "^1.14.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^4.1.12"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "deepmerge-ts": "^8.0.0",
    "fast-uri": "^3.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.6.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.61.1",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
