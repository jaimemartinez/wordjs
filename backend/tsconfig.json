{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "moduleDetection": "force",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    // strict is ON, but TWO sub-flags are deliberately OFF (be honest — this is a real gap, not
    // "nearly done"): noImplicitAny is off — enabling it currently surfaces ~1,220 implicit-any sites
    // still to annotate with real types (NOT blanket any), worked through incrementally; and
    // useUnknownInCatchVariables is off (catch bindings stay any for now). strictNullChecks,
    // strictFunctionTypes, strictBindCallApply, strictPropertyInitialization, noImplicitThis and
    // alwaysStrict ARE all enforced.
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "sourceMap": false,
    "rootDir": ".",
    "ignoreDeprecations": "6.0"
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "plugins", "themes", "dist", "data", "uploads"]
}
