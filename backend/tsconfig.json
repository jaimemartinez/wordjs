{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "moduleDetection": "force",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    // strict is ON. Two sub-flags are deliberately staged: noImplicitAny (the remaining ~1100
    // implicit-any params, to be annotated with real types file-by-file — NOT blanket any) and
    // useUnknownInCatchVariables (catch bindings stay any for now). strictNullChecks,
    // strictFunctionTypes, strictBindCallApply, strictPropertyInitialization, noImplicitThis and
    // alwaysStrict are all enforced.
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "sourceMap": false,
    "rootDir": ".",
    "ignoreDeprecations": "6.0"
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "plugins", "themes", "dist", "data", "uploads"]
}
