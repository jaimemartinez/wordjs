{
  "$schema": "wordjs-page-template-v1",
  "content": [
    {
      "type": "Section",
      "props": {
        "tag": "header",
        "className": "hero-scanline",
        "items": [
          { "type": "Spacer", "props": { "height": "1.5rem" } },
          {
            "type": "SearchBar",
            "props": {
              "placeholder": "> buscar en el circuito_",
              "buttonText": "EJECUTAR",
              "align": "center",
              "width": "min(40rem, 100%)"
            }
          },
          { "type": "Spacer", "props": { "height": "1.5rem" } }
        ]
      }
    },
    {
      "type": "Section",
      "props": {
        "tag": "div",
        "className": "franja-estado",
        "items": [
          { "type": "TemplatePart", "props": { "name": "estado", "area": "general" } }
        ]
      }
    },
    { "type": "Spacer", "props": { "height": "2.5rem" } },
    {
      "type": "Grid",
      "props": {
        "columns": 3,
        "columnsTablet": 2,
        "columnsMobile": 1,
        "gap": "1rem",
        "items": [
          {
            "type": "Section",
            "props": {
              "tag": "div",
              "className": "celda-ancha",
              "items": [
                { "type": "PostsGrid", "props": { "count": 4, "columns": 2, "gap": "1rem" } }
              ]
            }
          },
          { "type": "PostsGrid", "props": { "count": 3, "columns": 1, "gap": "1rem" } }
        ]
      }
    },
    { "type": "Spacer", "props": { "height": "3rem" } },
    { "type": "PageContent", "props": {} },
    { "type": "Spacer", "props": { "height": "3rem" } },
    { "type": "Divider", "props": { "color": "var(--wjs-color-primary)", "width": "1px" } },
    { "type": "Spacer", "props": { "height": "2rem" } }
  ]
}
