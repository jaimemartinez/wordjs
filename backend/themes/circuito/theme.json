        "font-family": "var(--wjs-font-family-mono)"
      },
      "formTitle": {
        "font-family": "var(--wjs-font-family-mono)"
      },
      "field": {
        "background": "var(--wjs-bg-muted)",
        "border": "1px solid var(--wjs-border-subtle)",
        "color": "var(--wjs-color-text-main)",
        "border-radius": "var(--wjs-radius)",
        "focus": {
          "border-color": "var(--wjs-color-primary)",
          "box-shadow": "var(--wjs-focus-ring)",
          "outline": "none"
        }
      },
      "submit": {
        "background": "var(--wjs-color-primary)",
        "color": "var(--wjs-color-on-primary)",
        "font-family": "var(--wjs-font-family-mono)",
