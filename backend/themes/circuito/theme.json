  "animations": {
    "scan-drift": {
      "from": {
        "background-position": "0 0"
      },
      "to": {
        "background-position": "0 8px"
      }
    },
    "neon-pulse": {
      "from": {
        "box-shadow": "0 0 6px rgba(34, 211, 238, 0.25), 0 0 18px rgba(34, 211, 238, 0.10)"
      },
      "50%": {
        "box-shadow": "0 0 10px rgba(34, 211, 238, 0.45), 0 0 28px rgba(34, 211, 238, 0.22)"
      },
      "to": {
        "box-shadow": "0 0 6px rgba(34, 211, 238, 0.25), 0 0 18px rgba(34, 211, 238, 0.10)"
      }
    },
    "caret-blink": {
      "from": {
        "border-color": "rgba(34, 211, 238, 0.9)"
      },
      "50%": {
        "border-color": "rgba(34, 211, 238, 0.25)"
      },
      "to": {
        "border-color": "rgba(34, 211, 238, 0.9)"
      }
    },
    "franja-sweep": {
      "from": {
        "background-position": "0% 0"
      },
      "to": {
        "background-position": "100% 0"
      }
    }
  },
