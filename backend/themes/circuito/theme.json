          "animation": "wjs-a-neon-pulse 2.6s ease-in-out infinite"
        }
      }
    },
    "chromeFooter": {
      "background": "var(--wjs-bg-surface)",
      "border-top": "1px solid var(--wjs-border-subtle)"
    },
    "postCard": {
      "background": "var(--wjs-bg-surface)",
      "border": "1px solid var(--wjs-border-subtle)",
      "border-radius": "var(--wjs-radius)",
      "transition": "border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease",
      "hover": {
        "border-color": "var(--wjs-color-primary)",
        "box-shadow": "0 0 18px rgba(34, 211, 238, 0.22), 0 0 42px rgba(34, 211, 238, 0.08)",
