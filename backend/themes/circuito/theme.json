      "border": "1px solid var(--wjs-border-subtle)",
      "border-radius": "var(--wjs-radius)",
      "author": {
        "font-family": "var(--wjs-font-family-mono)"
      },
      "date": {
        "color": "var(--wjs-color-text-muted)"
      }
    },
    "search": {
      "input": {
        "placeholder": {
          "color": "#5b6c92"
        },
        "motionOk": {
          "focus": {
            "animation": "wjs-a-caret-blink 1.2s steps(1, end) infinite"
          }
        }
      }
    },
    "searchForm": {
      "input": {
        "placeholder": {
          "color": "#5b6c92"
        },
        "motionOk": {
          "focus": {
            "animation": "wjs-a-caret-blink 1.2s steps(1, end) infinite"
          }
        }
      }
    },
    "variations": {
      "hero-scanline": {
        "padding": "5rem 2rem 4rem",
        "background-color": "var(--wjs-bg-surface)",
        "background-image": "repeating-linear-gradient(0deg, rgba(34, 211, 238, 0.05) 0px, rgba(34, 211, 238, 0.05) 1px, transparent 1px, transparent 4px)",
        "border-bottom": "1px solid var(--wjs-border-subtle)",
        "motionOk": {
          "animation": "wjs-a-scan-drift 7s linear infinite"
        },
        "belowDesktop": {
          "padding": "3rem 1rem 2.5rem"
        },
        "mobile": {
          "padding": "2rem 1rem"
        }
      },
      "glow-panel": {
        "background": "var(--wjs-bg-surface)",
        "background-image": "linear-gradient(180deg, rgba(34, 211, 238, 0.06), transparent 45%)",
        "border": "1px solid rgba(34, 211, 238, 0.3)",
        "border-radius": "8px",
        "padding": "2.5rem",
        "box-shadow": "0 0 24px rgba(34, 211, 238, 0.08)",
        "belowDesktop": {
          "padding": "1.25rem"
        }
      },
      "celda-ancha": {
        "grid-column": "span 2",
        "min-width": "0",
        "mobile": {
          "grid-column": "auto"
        }
      },
      "franja-estado": {
        "padding": "0.6rem 2rem",
        "background": "var(--wjs-bg-muted)",
        "background-image": "linear-gradient(90deg, transparent 42%, rgba(34, 211, 238, 0.08) 50%, transparent 58%)",
        "background-size": "300% 100%",
        "background-repeat": "no-repeat",
        "background-position": "0% 0",
        "border-bottom": "1px solid var(--wjs-border-subtle)",
        "font-family": "var(--wjs-font-family-mono)",
        "font-size": "0.8rem",
        "letter-spacing": "0.05em",
        "color": "var(--wjs-color-text-muted)",
        "motionOk": {
          "animation": "wjs-a-franja-sweep 9s linear infinite"
        }
      }
    },
    "spacer": {
      "mobile": {
        "max-height": "2.5rem"
      }
    },
    "pricing": {
      "gap": "0.75rem",
      "plan": {
        "padding": "1.25rem"
      },
      "tablet": {
        "grid-template-columns": "repeat(2, 1fr)"
      }
    }
