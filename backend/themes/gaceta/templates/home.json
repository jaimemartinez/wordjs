{
    "$schema": "wordjs-page-template-v1",
    "content": [
        {
            "type": "Section",
            "props": {
                "tag": "header",
                "className": "hero-manchette",
                "maxWidth": "1140px",
                "items": [
                    {
                        "type": "Divider",
                        "props": {
                            "color": "var(--wjs-color-text-main)",
                            "width": "2px",
                            "gap": "0.75rem"
                        }
                    },
                    {
                        "type": "PostsGrid",
                        "props": {
                            "count": 3,
                            "columns": 3,
                            "gap": "2rem"
                        }
                    }
                ]
            }
        },
        {
            "type": "Spacer",
            "props": {
                "height": "3rem"
            }
        },
        {
            "type": "Section",
            "props": {
                "maxWidth": "1140px",
                "items": [
                    {
                        "type": "Grid",
                        "props": {
                            "columns": 2,
                            "columnsTablet": 1,
                            "columnsMobile": 1,
                            "gap": "3rem",
                            "items": [
                                {
                                    "type": "CategoryPosts",
                                    "props": {
                                        "count": 6,
                                        "layout": "list"
                                    }
                                },
                                {
                                    "type": "PageContent",
                                    "props": {}
                                }
                            ]
                        }
                    }
                ]
            }
        },
        {
            "type": "Spacer",
            "props": {
                "height": "4rem"
            }
        }
    ]
}
