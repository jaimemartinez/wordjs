{
    "$schema": "wordjs-page-template-v1",
    "content": [
        { "type": "Spacer", "props": { "height": "2.5rem" } },
        {
            "type": "Section",
            "props": {
                "maxWidth": "40rem",
                "items": [
                    { "type": "SearchBar", "props": { "align": "center", "width": "100%", "placeholder": "Search the gazette…", "buttonText": "Search" } }
                ]
            }
        },
        { "type": "Spacer", "props": { "height": "2rem" } },
        {
            "type": "Section",
            "props": {
                "maxWidth": "1140px",
                "items": [
                    { "type": "PageContent", "props": {} }
                ]
            }
        },
        { "type": "Spacer", "props": { "height": "4rem" } }
    ]
}
