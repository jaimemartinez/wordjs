# WordJS Security & Config (SENSITIVE)
wordjs-config.json
backend/wordjs-config.json
# Catch every wordjs-config variant (e.g. wordjs-config.backup.json) in any dir — these hold
# jwtSecret/gatewaySecret/dbPassword and must NEVER be committed.
**/wordjs-config*.json
gateway/gateway-config.json
gateway-registry.json
**/certs/
*.key
*.crt
*.pem
ssl/
backend/ssl/
gateway/ssl/

