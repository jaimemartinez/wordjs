# Dependencies
**/node_modules/
# package-lock.json is intentionally COMMITTED — reproducible builds + a meaningful npm audit / Dependabot gate.
pnpm-lock.yaml
yarn.lock

# Environment
.env
.env.local
.env.*

# Local Claude MCP config — holds a personal Stitch (Google) API key; never commit
.claude/mcp.json
**/.env
**/.env.local
**/.env.*

# WordJS Security & Config (SENSITIVE)
wordjs-config.json
backend/wordjs-config.json
# Catch every wordjs-config variant (e.g. wordjs-config.backup.json) in any dir — these hold
# jwtSecret/gatewaySecret/dbPassword and must NEVER be committed.
**/wordjs-config*.json
gateway/gateway-config.json
gateway-registry.json
**/certs/
*.key
*.crt
*.pem
ssl/
backend/ssl/
gateway/ssl/

# WordJS Data (DO NOT COMMIT)
data/
backend/data/
backend/uploads/
backend/os-tmp/
**/tmp/
*.db
*.sqlite
*.sqlite3
# SQLite sidecar files — scoped to real DB names so the bare -wal/-shm/-journal
# patterns don't swallow unrelated paths (e.g. a theme slug ending in "-journal").
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Logs & Debug
logs/
**/logs/
*.log
**/debug_*.txt
**/debug_*.js
backend/commands.txt
backend/Propuesta.pdf

# Next.js & Build Artifacts
.next/
out/
build/
dist/
**/build/
**/dist/
tsconfig.tsbuildinfo

# WordJS Releases
/release/
/release-bundles/

# System Files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Client-Specific Content (Restricted)
backend/themes/vidaParaTodos/
backend/themes/toscano/
frontend/public/toscano.html
backend/plugins/toscano/
backend/plugins/toscano-platform/
frontend/src/app/portal/toscano/


# Verso: corpus de contenido REAL de producción para el gate de round-trip (títulos/HTML sin
# anonimizar, incluye bloques de plugins de cliente) — regenerable con scripts/verso-corpus-export.mjs
documentation/verso/corpus/

# Local knowledge-graph cache + scratch files (regenerated; do not track)
graphify-out/
temp_*
# Red-team scratch artifact left in the plugins dir (not a real plugin; test uses /tmp instead)
backend/plugins/malicious.txt

# Local editor backup scratch dirs (do not track)
frontend/_backups/
frontend/src/app/_backup/

# marketplace/dist/ is a BUILD OUTPUT (catalog index + one zip per plugin) — intentionally NOT committed
# (ignored by `**/dist/` above). It is published as GitHub Release ASSETS by release.yml and served from
# releases/latest/download (the default marketplace_source). Regenerate for dev with `npm run build:marketplace`.
cluster-tokens.json
gateway/cluster-tokens.json
# Stitch MCP config (contains API key — never commit)
.mcp.json
.claude/mcp.json

# Generated per-machine from the plugins that happen to be INSTALLED (frontend prebuild/predev,
# and regenerated in CI before type-check). Committing them snapshots one developer's local plugin
# set into the public repo — which is how a private client plugin's name reached HEAD. The build
# always regenerates them, so they must never be tracked.
# NOTE: assetVersion.generated.ts is deliberately NOT here — it is a deterministic hash of
# wordjs-ui.css and CI has a drift gate that fails if it is untracked.
frontend/src/lib/pluginRegistry.ts
frontend/src/lib/versoPluginRegistry.ts
frontend/src/app/admin/plugin/\[slug\]/page.tsx

# Runtime log rotation state — a dev machine artifact, never source (was committed by accident)
logs/

# Internal audit write-ups stay OUT of the public repo until their findings are remediated
/AUDITORIA_*.md
