documentation/verso/corpus/

# Local knowledge-graph cache + scratch files (regenerated; do not track)
graphify-out/
temp_*
# Red-team scratch artifact left in the plugins dir (not a real plugin; test uses /tmp instead)
backend/plugins/malicious.txt

# Local editor backup scratch dirs (do not track)
frontend/_backups/
frontend/src/app/_backup/

# marketplace/dist/ is a BUILD OUTPUT (catalog index + one zip per plugin) — intentionally NOT committed
# (ignored by `**/dist/` above). It is published as GitHub Release ASSETS by release.yml and served from
# releases/latest/download (the default marketplace_source). Regenerate for dev with `npm run build:marketplace`.
cluster-tokens.json
gateway/cluster-tokens.json
# Stitch MCP config (contains API key — never commit)
.mcp.json
.claude/mcp.json

# Generated per-machine from the plugins that happen to be INSTALLED (frontend prebuild/predev,
# and regenerated in CI before type-check). Committing them snapshots one developer's local plugin
# set into the public repo — which is how a private client plugin's name reached HEAD. The build
# always regenerates them, so they must never be tracked.
# NOTE: assetVersion.generated.ts is deliberately NOT here — it is a deterministic hash of
# wordjs-ui.css and CI has a drift gate that fails if it is untracked.
frontend/src/lib/pluginRegistry.ts
frontend/src/lib/versoPluginRegistry.ts
frontend/src/app/admin/plugin/\[slug\]/page.tsx

# Runtime log rotation state — a dev machine artifact, never source (was committed by accident)
logs/

# Internal audit write-ups stay OUT of the public repo until their findings are remediated
/AUDITORIA_*.md

# ---------------------------------------------------------------------------
# Debug artefacts. These are written by hand or by scripts/stitch-*.mjs during
# investigation and MUST NOT be tracked: cj.txt is a curl cookie jar that holds
# a LIVE wordjs_token whenever it is regenerated, and the page/mirror dumps are
# whole-page payloads. release-excludes.test.ts already names three of them, but
# it only filters `git ls-files` output — that protection INVERTS the moment they
# become tracked, at which point they would ship inside the release ZIP.
#
# `/.debug-dumps/` is the rule that covers the CLASS, and it only works because the
# PRODUCERS agree with it: scripts/stitch-dump-path.mjs `dumpPath()` resolves every
# dump into that directory, including an operator-typed `--out probe.json` (which is
# how page172.json / put208.json / mirror2.json were born uncovered). The literal
# names below stay for the files already on disk from before that change.
#
# Names are not a gate, though: the next cookie jar can be called anything. The gate
# is `.githooks/pre-commit` (`npm run hooks:install`), which scans staged CONTENT for
# session tokens, pinned by backend/src/tests/repo-hygiene-secrets.test.ts.
# ---------------------------------------------------------------------------
cj.txt
*.cookies
cookies*.txt
cookie-jar*.txt
/.debug-dumps/
/emitted.json
/fidelity-diff.json
/mirror*.json
/page[0-9]*.json
/put[0-9]*.json
.stitch-cache/
backend/plugins/stitch-themes/

# Scratch tree built by backend/src/tests/verify-installer.test.ts (relocates config/app.ts to
# simulate a site root with no wordjs-config.json). Removed on both the passing and failing path;
# ignored as well so a regression in that cleanup can never put it in a commit.
backend/tmp-installer-test/
