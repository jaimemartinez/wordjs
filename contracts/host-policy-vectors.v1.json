    { "policy": "prod", "host": "192.168.1.50:3000", "cls": "alias" },
    { "policy": "prod", "host": "192.168.1.50", "proxied": true, "cls": "alias", "why": "declared addresses match before the R4 rule" },
    { "policy": "prod", "host": "ingress.example.net", "cls": "env" },
    { "policy": "prod", "host": "tls.example.net:443", "cls": "env" },
    { "policy": "prod", "host": "localhost:3000", "cls": "loopback" },
    { "policy": "prod", "host": "127.0.0.2", "cls": "loopback" },
    { "policy": "prod", "host": "[::1]:3000", "cls": "loopback" },
    { "policy": "prod", "host": "[::ffff:127.0.0.1]", "cls": "loopback" },
