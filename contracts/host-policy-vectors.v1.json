    { "name": "R4: X-Real-IP", "req": { "remoteAddress": "192.168.5.9", "headers": { "host": "192.168.5.20:3000", "x-real-ip": "203.0.113.9" } }, "expect": { "proxied": true } },
    { "name": "R4: Forwarded", "req": { "remoteAddress": "192.168.5.9", "headers": { "host": "192.168.5.20:3000", "forwarded": "for=203.0.113.9" } }, "expect": { "proxied": true } },
    { "name": "R4: Via", "req": { "remoteAddress": "192.168.5.9", "headers": { "host": "192.168.5.20:3000", "via": "1.1 proxy" } }, "expect": { "proxied": true } },
    { "name": "R4: XFH that differs from Host", "req": { "remoteAddress": "192.168.5.9", "headers": { "host": "192.168.5.20:3000", "x-forwarded-host": "blog.example" } }, "expect": { "host": "192.168.5.20:3000", "proxied": true } },
    { "name": "R4: the monolith's own pin (XFH equal to Host) is not a proxy", "req": { "remoteAddress": "192.168.1.77", "headers": { "host": "192.168.1.11:3000", "x-forwarded-host": "192.168.1.11:3000" } }, "expect": { "host": "192.168.1.11:3000", "proxied": false } },
    { "name": "R4: proxy headers from a trusted hop are expected", "req": { "remoteAddress": "127.0.0.1", "headers": { "host": "127.0.0.1:4000", "x-forwarded-host": "192.168.1.11:3000", "x-forwarded-for": "192.168.1.77" } }, "expect": { "host": "192.168.1.11:3000", "proxied": false } },
    { "name": "operator trust 'loopback' does not reopen DNS rebinding: a dotted Host keeps a forged XFH unread", "trustProxy": "loopback", "req": { "remoteAddress": "127.0.0.1", "headers": { "host": "rebind.attacker:4000", "x-forwarded-host": "example.com" } }, "expect": { "host": "rebind.attacker:4000", "absent": false, "hop": "operator", "source": "host", "proxied": false } },
    { "name": "operator trust on a LAN subnet: a rebinding page in a LAN victim's browser", "trustProxy": "192.168.0.0/16", "req": { "remoteAddress": "192.168.1.77", "headers": { "host": "rebind.attacker:3000", "x-forwarded-host": "example.com" } }, "expect": { "host": "rebind.attacker:3000", "hop": "operator", "source": "host" } },
    { "name": "operator proxy dialling a single-label upstream name: XFH read", "trustProxy": "10.0.0.0/8", "req": { "remoteAddress": "10.1.2.3", "headers": { "host": "wordjs_backend:4000", "x-forwarded-host": "example.com" } }, "expect": { "host": "example.com", "hop": "operator", "source": "x-forwarded-host" } },
