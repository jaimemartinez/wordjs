    { "policy": "prod", "host": "[2001:db8::99]", "proxied": true, "cls": "unknown", "reason": "proxied-ip", "why": "R4" },
    { "policy": "prod", "host": "evil.example", "cls": "unknown", "reason": "undeclared" },
    { "policy": "prod", "host": "rebind.test:4000", "cls": "unknown", "reason": "undeclared" },
    { "policy": "prod", "host": "wordjs_upstream", "cls": "unknown", "reason": "undeclared" },
    { "policy": "prod", "host": "mi-pc.local", "cls": "unknown", "reason": "undeclared" },
    { "policy": "prod", "host": "example.com.evil.example", "cls": "unknown" },
    { "policy": "prod", "host": "evilexample.com", "cls": "unknown" },
    { "policy": "prod-own", "host": "192.168.1.11:3000", "cls": "ip", "reason": "ip-own" },
    { "policy": "prod-own", "host": "[2001:db8::11]", "cls": "ip", "reason": "ip-own" },
    { "policy": "prod-own", "host": "192.168.1.23", "cls": "unknown", "reason": "ip-not-own" },
    { "policy": "prod-own", "host": "127.0.0.1", "cls": "loopback" },
    { "policy": "prod-none", "host": "192.168.1.11", "cls": "unknown", "reason": "ip-literals-none" },
    { "policy": "prod-none", "host": "[::1]", "cls": "loopback" },
    { "policy": "prod-env-ip-override", "host": "192.168.1.23", "cls": "unknown", "reason": "ip-literals-none" },
    { "policy": "prod-dev-origins-ignored", "host": "mi-pc.local", "cls": "unknown" },
