  "requestAuthority": [
    { "name": "rebinding page on the loopback port: its forged XFH is ignored", "req": { "remoteAddress": "127.0.0.1", "headers": { "host": "rebind.test:4000", "x-forwarded-host": "example.com" } }, "expect": { "host": "rebind.test:4000", "absent": false, "hop": null, "source": "host", "proxied": true } },
    { "name": "loopback hop that addressed loopback: XFH honoured", "req": { "remoteAddress": "127.0.0.1", "headers": { "host": "127.0.0.1:4000", "x-forwarded-host": "example.com" } }, "expect": { "host": "example.com", "hop": "local", "source": "x-forwarded-host", "proxied": false } },
    { "name": "loopback hop relays whatever it was sent", "req": { "remoteAddress": "127.0.0.1", "headers": { "host": "127.0.0.1:4000", "x-forwarded-host": "evil.example" } }, "expect": { "host": "evil.example", "hop": "local" } },
    { "name": "IPv6 loopback hop", "req": { "remoteAddress": "::1", "headers": { "host": "[::1]:4000", "x-forwarded-host": "example.com" } }, "expect": { "host": "example.com", "hop": "local" } },
    { "name": "IPv4-mapped loopback peer (R15)", "req": { "remoteAddress": "::ffff:127.0.0.1", "headers": { "host": "localhost:4000", "x-forwarded-host": "example.com" } }, "expect": { "host": "example.com", "hop": "local" } },
    { "name": "mTLS peer that is not the gateway", "req": { "remoteAddress": "10.0.0.7", "authorized": true, "peerCN": "frontend", "headers": { "host": "10.0.0.5:4000", "x-forwarded-host": "example.com" } }, "expect": { "host": "10.0.0.5:4000", "hop": null, "source": "host" } },
    { "name": "mTLS gateway-internal", "req": { "remoteAddress": "10.0.0.7", "authorized": true, "peerCN": "gateway-internal", "headers": { "host": "10.0.0.5:4000", "x-forwarded-host": "example.com", "x-forwarded-for": "203.0.113.9" } }, "expect": { "host": "example.com", "hop": "gateway", "proxied": false } },
    { "name": "mTLS gateway", "req": { "remoteAddress": "10.0.0.7", "authorized": true, "peerCN": "gateway", "headers": { "host": "10.0.0.5:4000", "x-forwarded-host": "example.com" } }, "expect": { "host": "example.com", "hop": "gateway" } },
    { "name": "CN gateway on a certificate that did not verify", "req": { "remoteAddress": "10.0.0.7", "authorized": false, "peerCN": "gateway", "headers": { "host": "10.0.0.5:4000", "x-forwarded-host": "example.com" } }, "expect": { "host": "10.0.0.5:4000", "hop": null } },
    { "name": "operator subnet trust", "trustProxy": "10.0.0.0/8", "req": { "remoteAddress": "10.1.2.3", "headers": { "host": "10.0.0.5:3000", "x-forwarded-host": "example.com", "x-forwarded-for": "203.0.113.9" } }, "expect": { "host": "example.com", "hop": "operator", "proxied": false } },
    { "name": "operator subnet trust, peer outside it", "trustProxy": "10.0.0.0/8", "req": { "remoteAddress": "192.168.5.9", "headers": { "host": "example.com", "x-forwarded-host": "evil.example" } }, "expect": { "host": "example.com", "hop": null } },
    { "name": "R11: a hop count never makes XFH trustworthy", "trustProxy": 1, "req": { "remoteAddress": "10.1.2.3", "headers": { "host": "10.0.0.5:3000", "x-forwarded-host": "example.com", "x-forwarded-for": "203.0.113.9" } }, "expect": { "host": "10.0.0.5:3000", "hop": null, "proxied": true } },
    { "name": "R11: a numeric string hop count", "trustProxy": "1", "req": { "remoteAddress": "10.1.2.3", "headers": { "host": "10.0.0.5:3000", "x-forwarded-host": "example.com" } }, "expect": { "host": "10.0.0.5:3000", "hop": null } },
    { "name": "R11: trust everything", "trustProxy": true, "req": { "remoteAddress": "10.1.2.3", "headers": { "host": "10.0.0.5:3000", "x-forwarded-host": "example.com" } }, "expect": { "host": "10.0.0.5:3000", "hop": null } },
    { "name": "operator trust list as an array", "trustProxy": ["192.168.0.0/16", "10.0.0.0/8"], "req": { "remoteAddress": "10.1.2.3", "headers": { "host": "10.0.0.5:3000", "x-forwarded-host": "example.com" } }, "expect": { "host": "example.com", "hop": "operator" } },
    { "name": "comma-joined XFH: the first hop", "req": { "remoteAddress": "127.0.0.1", "headers": { "host": "127.0.0.1:4000", "x-forwarded-host": "a.example, b.example" } }, "expect": { "host": "a.example", "hop": "local" } },
