{
  "version": 1,
  "description": "Conformance vectors for host-policy.js. Both copies (backend/src/core/host-policy.js and gateway/src/host-policy.js) must pass every vector: backend/src/tests/host-policy.test.ts and gateway/test/host-policy-parity.test.js run this file. Add a vector here before changing the grammar, never after.",
  "parseHost": {
    "accept": [
      { "in": "example.com", "hostname": "example.com", "port": null, "kind": "dns" },
      { "in": "EXAMPLE.com:443", "hostname": "example.com", "port": 443, "kind": "dns", "why": "case folded, explicit port kept" },
      { "in": "example.com.", "hostname": "example.com", "port": null, "kind": "dns", "why": "one trailing dot is the same name" },
      { "in": "example.com.:8443", "hostname": "example.com", "port": 8443, "kind": "dns" },
      { "in": "localhost", "hostname": "localhost", "port": null, "kind": "dns" },
      { "in": "localhost.", "hostname": "localhost", "port": null, "kind": "dns" },
      { "in": "localhost:3000", "hostname": "localhost", "port": 3000, "kind": "dns" },
      { "in": "app.localhost:3000", "hostname": "app.localhost", "port": 3000, "kind": "dns" },
      { "in": "127.0.0.1:4000", "hostname": "127.0.0.1", "port": 4000, "kind": "ipv4" },
      { "in": "127.0.0.2", "hostname": "127.0.0.2", "port": null, "kind": "ipv4" },
      { "in": "0.0.0.0", "hostname": "0.0.0.0", "port": null, "kind": "ipv4" },
      { "in": "192.168.1.23:3000", "hostname": "192.168.1.23", "port": 3000, "kind": "ipv4" },
      { "in": "255.255.255.255:65535", "hostname": "255.255.255.255", "port": 65535, "kind": "ipv4" },
      { "in": "[::1]", "hostname": "[::1]", "port": null, "kind": "ipv6" },
      { "in": "[::1]:3000", "hostname": "[::1]", "port": 3000, "kind": "ipv6" },
      { "in": "[0:0:0:0:0:0:0:1]", "hostname": "[::1]", "port": null, "kind": "ipv6", "why": "WHATWG compression" },
      { "in": "[2001:DB8:0::1]", "hostname": "[2001:db8::1]", "port": null, "kind": "ipv6" },
      { "in": "[2001:db8::1]:8443", "hostname": "[2001:db8::1]", "port": 8443, "kind": "ipv6" },
      { "in": "[::ffff:127.0.0.1]", "hostname": "[::ffff:7f00:1]", "port": null, "kind": "ipv6", "why": "WHATWG prints the mapped address in hex" },
      { "in": "wordjs_upstream", "hostname": "wordjs_upstream", "port": null, "kind": "dns", "why": "parses; classifies as unknown with the forward-Host hint" },
      { "in": "wordjs:3000", "hostname": "wordjs", "port": 3000, "kind": "dns" },
      { "in": "xn--bcher-kva.example", "hostname": "xn--bcher-kva.example", "port": null, "kind": "dns", "why": "punycode is ASCII" },
      { "in": "192.168.1.11.nip.io", "hostname": "192.168.1.11.nip.io", "port": null, "kind": "dns", "why": "a name whose labels are mostly numeric is still a name" },
      { "in": "a-b.c_d.example", "hostname": "a-b.c_d.example", "port": null, "kind": "dns" },
      { "in": "1e100.net", "hostname": "1e100.net", "port": null, "kind": "dns" }
    ],
    "reject": [
      { "in": "", "why": "empty" },
      { "in": "localhost:1@evil.example", "why": "userinfo: WHATWG reads evil.example, a naive split reads localhost" },
      { "in": "evil.example@localhost", "why": "userinfo" },
      { "in": "a.com, b.com", "why": "two joined values" },
      { "in": "a.com,b.com", "why": "two joined values" },
      { "in": "a b", "why": "whitespace" },
      { "in": "example.com\t", "why": "control character" },
      { "in": "127.1", "why": "short numeric form" },
      { "in": "0x7f.0.0.1", "why": "hex octet" },
      { "in": "2130706433", "why": "integer IPv4" },
      { "in": "01.2.3.4", "why": "leading zero: octal to some resolvers" },
      { "in": "1.2.3.04", "why": "leading zero" },
      { "in": "999.1.1.1", "why": "octet out of range" },
      { "in": "1.2.3.4.5", "why": "five numeric labels" },
      { "in": "a.123", "why": "numeric last label" },
      { "in": "a.0x10", "why": "WHATWG reads a hex last label as an IPv4 number (tripwire)" },
      { "in": "xn--a.com", "why": "invalid punycode (tripwire)" },
      { "in": "example.com:99999", "why": "port out of range" },
      { "in": "example.com:65536", "why": "port out of range" },
      { "in": "example.com:0", "why": "port zero" },
      { "in": "example.com:080", "why": "leading zero in port" },
      { "in": ":abc", "why": "no host, non-numeric port" },
      { "in": ":80", "why": "no host" },
      { "in": "example.com:", "why": "empty port" },
      { "in": "host:80:80", "why": "two ports" },
      { "in": "[fe80::1%25eth0]", "why": "zone id" },
      { "in": "[fe80::1%eth0]", "why": "zone id" },
      { "in": "::1", "why": "bare IPv6" },
      { "in": "[x]", "why": "not an IPv6 address" },
      { "in": "[::1", "why": "unclosed bracket" },
      { "in": "[::1]:", "why": "empty port" },
      { "in": "[::1]x", "why": "garbage after bracket" },
      { "in": "[::1]]", "why": "garbage after bracket" },
      { "in": "<script>", "why": "markup" },
      { "in": "%2e", "why": "percent escape" },
      { "in": "evil%2eexample", "why": "percent escape" },
      { "in": "bücher.example", "why": "raw non-ASCII" },
      { "in": "例え.jp", "why": "raw non-ASCII" },
      { "in": "example.com..", "why": "only ONE trailing dot is stripped" },
      { "in": ".", "why": "empty name" },
      { "in": ".example.com", "why": "empty label" },
      { "in": "a..b", "why": "empty label" },
      { "in": "-a.example", "why": "leading hyphen" },
      { "in": "a-.example", "why": "trailing hyphen" },
      { "in": "*.example.com", "why": "wildcard" },
      { "in": "example.com/path", "why": "path" },
      { "in": "example.com?x", "why": "query" },
      { "in": "example.com#x", "why": "fragment" },
      { "in": "exa\\mple.com", "why": "backslash" },
      { "in": "a\"b", "why": "quote" },
      { "in": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "why": "64-character label" },
      { "in": "aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.aaaaaaaaaa.example", "why": "name longer than 253" }
    ]
  },
  "parseSiteUrl": {
    "accept": [
      { "in": "https://example.com", "origin": "https://example.com", "scheme": "https", "hostname": "example.com", "port": null, "kind": "dns" },
      { "in": "https://example.com/", "origin": "https://example.com", "scheme": "https", "hostname": "example.com", "port": null, "kind": "dns" },
      { "in": "HTTPS://Example.COM:443/", "origin": "https://example.com", "scheme": "https", "hostname": "example.com", "port": null, "kind": "dns", "why": "default port dropped" },
      { "in": "http://example.com:443", "origin": "http://example.com:443", "scheme": "http", "hostname": "example.com", "port": 443, "kind": "dns" },
      { "in": "  https://example.com  ", "origin": "https://example.com", "scheme": "https", "hostname": "example.com", "port": null, "kind": "dns", "why": "surrounding whitespace trimmed" },
      { "in": "https://example.com.", "origin": "https://example.com", "scheme": "https", "hostname": "example.com", "port": null, "kind": "dns" },
      { "in": "http://localhost:3000", "origin": "http://localhost:3000", "scheme": "http", "hostname": "localhost", "port": 3000, "kind": "dns" },
      { "in": "http://192.168.1.50:3000", "origin": "http://192.168.1.50:3000", "scheme": "http", "hostname": "192.168.1.50", "port": 3000, "kind": "ipv4" },
      { "in": "http://[::1]:3000", "origin": "http://[::1]:3000", "scheme": "http", "hostname": "[::1]", "port": 3000, "kind": "ipv6" },
      { "in": "https://bücher.example", "origin": "https://xn--bcher-kva.example", "scheme": "https", "hostname": "xn--bcher-kva.example", "port": null, "kind": "dns", "why": "stored and shown as punycode" }
    ],
    "reject": [
      { "in": "", "why": "empty" },
      { "in": "javascript:alert(1)", "why": "scheme" },
      { "in": "ftp://example.com", "why": "scheme" },
      { "in": "example.com", "why": "no scheme" },
      { "in": "//example.com", "why": "no scheme" },
      { "in": "https://", "why": "no host" },
      { "in": "https:///example.com", "why": "empty authority" },
      { "in": "https,https://x", "why": "the old /migrate X-Forwarded-Proto corruption" },
      { "in": "https://a@b.example", "why": "userinfo" },
      { "in": "https://@b.example", "why": "empty userinfo" },
      { "in": "https://user:pw@example.com", "why": "userinfo" },
      { "in": "https://x/path", "why": "path" },
      { "in": "https://example.com//", "why": "path" },
      { "in": "https://example.com/?", "why": "empty query" },
      { "in": "https://example.com?x=1", "why": "query" },
      { "in": "https://example.com#", "why": "empty fragment" },
      { "in": "https://*.example.com", "why": "wildcard" },
      { "in": "http://[::1", "why": "unclosed bracket" },
      { "in": "https://ex%61mple.com", "why": "percent escape WHATWG would decode" },
      { "in": "https:\\\\example.com", "why": "backslashes WHATWG would rewrite" },
      { "in": "https://exa mple.com", "why": "whitespace" },
      { "in": "https://example.com:0", "why": "port zero" },
      { "in": "https://127.1", "why": "short numeric form WHATWG would rewrite to 127.0.0.1" },
      { "in": "https://2130706433", "why": "integer IPv4 WHATWG would rewrite" },
      { "in": "https://0x7f.0.0.1", "why": "hex octet WHATWG would rewrite" },
      { "in": "http://example.com:0443", "why": "leading zero in port" },
      { "in": "https://１２７.１", "why": "full-width digits WHATWG folds into an IPv4 address" },
      { "in": "https://ｅxample.com", "why": "a full-width letter WHATWG folds into plain ASCII" },
      { "in": "https://exa_mple.com:3000x", "why": "garbage port" },
      { "in": "http://[fe80::1%25eth0]", "why": "zone id" }
    ]
  },
  "ownAddresses": {
    "interfaces": {
      "Wi-Fi": [
        { "address": "192.168.1.11", "family": "IPv4", "internal": false },
        { "address": "fe80::1", "family": "IPv6", "internal": false },
        { "address": "2001:DB8::11", "family": "IPv6", "internal": false }
      ],
      "Loopback Pseudo-Interface 1": [
        { "address": "127.0.0.1", "family": "IPv4", "internal": true },
        { "address": "::1", "family": "IPv6", "internal": true }
      ],
      "Legacy Node 18.0": [
        { "address": "10.0.0.5", "family": 4, "internal": false },
        { "address": "fd12:3456::1", "family": 6, "internal": false }
      ],
      "APIPA": [{ "address": "169.254.3.4", "family": "IPv4", "internal": false }],
      "Scoped link-local": [{ "address": "fe80::abcd%12", "family": "IPv6", "internal": false }],
      "Down adapter": null
    },
    "expect": ["10.0.0.5", "192.168.1.11", "[2001:db8::11]", "[fd12:3456::1]"]
  },
  "compileTrustProxy": [
    { "setting": "loopback", "compiles": true, "peers": { "127.0.0.1": true, "::1": true, "::ffff:127.0.0.1": true, "10.0.0.1": false } },
    { "setting": "10.0.0.0/8", "compiles": true, "peers": { "10.1.2.3": true, "::ffff:10.1.2.3": true, "11.0.0.1": false, "127.0.0.1": false } },
    { "setting": "10.0.0.0/8, loopback", "compiles": true, "peers": { "127.0.0.1": true, "10.9.9.9": true, "192.168.1.1": false } },
    { "setting": ["10.0.0.0/8", "192.168.0.0/16"], "compiles": true, "peers": { "192.168.1.1": true, "172.16.0.1": false } },
    { "setting": "uniquelocal", "compiles": true, "peers": { "172.16.5.4": true, "fd00::1": true, "8.8.8.8": false } },
    { "setting": "linklocal", "compiles": true, "peers": { "169.254.1.1": true, "fe80::1": true, "10.0.0.1": false } },
    { "setting": "203.0.113.7", "compiles": true, "peers": { "203.0.113.7": true, "203.0.113.8": false } },
    { "setting": "2001:db8::/32", "compiles": true, "peers": { "2001:db8::5": true, "2001:db9::5": false } },
    { "setting": 1, "compiles": false, "why": "hop count: Express trusts every peer at i=0" },
    { "setting": "1", "compiles": false, "why": "hop count" },
    { "setting": 2, "compiles": false, "why": "hop count" },
    { "setting": true, "compiles": false, "why": "trust everything" },
    { "setting": "true", "compiles": false, "why": "trust everything" },
    { "setting": false, "compiles": false },
    { "setting": "false", "compiles": false },
    { "setting": null, "compiles": false },
    { "setting": "", "compiles": false },
    { "setting": "10.0.0.0/33", "compiles": false, "why": "prefix out of range" },
    { "setting": "10.0.0.0/255.0.0.0", "compiles": false, "why": "netmask form not supported" },
    { "setting": "not-an-ip", "compiles": false },
    { "setting": "10.0.0.0/8, nonsense", "compiles": false, "why": "one bad element voids the list" },
    { "setting": [1], "compiles": false },
    { "setting": ["10.0.0.1", 2], "compiles": false }
  ],
  "policies": {
    "prod": {
      "nodeEnv": "production",
      "config": {
        "siteUrl": "https://example.com",
        "siteAliases": [
          { "url": "https://www.example.com", "mode": "serve", "label": "www", "source": "admin" },
          { "url": "https://ab12.ngrok-free.app", "expiresAt": "2026-10-12T00:00:00Z", "source": "cli" },
          { "url": "https://old.example.org", "expiresAt": "2026-01-01T00:00:00Z" },
          { "url": "http://192.168.1.50:3000", "signIn": true },
          { "url": "http://intranet.example.com" },
          { "url": "https://printer.local" },
          { "url": "https://legacy.example.net", "mode": "redirect" }
        ]
      },
      "env": { "WORDJS_ALLOWED_HOSTS": "ingress.example.net, https://tls.example.net, 192.168.9.9" },
      "ownAddresses": ["192.168.1.11", "[2001:db8::11]"]
    },
    "prod-own": {
      "nodeEnv": "production",
      "config": { "siteUrl": "https://example.com", "hostPolicy": { "ipLiterals": "own" } },
      "env": {},
      "ownAddresses": ["192.168.1.11", "[2001:db8::11]"]
    },
    "prod-none": {
      "nodeEnv": "production",
      "config": { "siteUrl": "https://example.com", "hostPolicy": { "ipLiterals": "none" } },
      "env": {},
      "ownAddresses": ["192.168.1.11"]
    },
    "prod-env-ip-override": {
      "nodeEnv": "production",
      "config": { "siteUrl": "https://example.com", "hostPolicy": { "ipLiterals": "any" } },
      "env": { "WORDJS_IP_HOSTS": "NONE" },
      "ownAddresses": []
    },
    "prod-dev-origins-ignored": {
      "nodeEnv": "production",
      "config": { "siteUrl": "http://localhost:3000" },
      "env": { "WORDJS_DEV_ORIGINS": "mi-pc.local,devbox" },
      "ownAddresses": []
    },
    "dev": {
      "nodeEnv": "development",
      "config": { "siteUrl": "http://localhost:3000" },
      "env": { "WORDJS_DEV_ORIGINS": " Mi-PC.local , ,devbox:3000, http://lan-box.example:8080" },
      "ownAddresses": ["192.168.1.11"]
    },
    "test-env-is-not-dev": {
      "nodeEnv": "test",
      "config": { "siteUrl": "http://localhost:3000" },
      "env": { "WORDJS_DEV_ORIGINS": "devbox" },
      "ownAddresses": []
    },
    "env-precedence": {
      "nodeEnv": "development",
      "config": { "siteUrl": "https://example.com", "siteAliases": [{ "url": "https://www.example.com" }], "hostPolicy": { "ipLiterals": "none" } },
      "env": { "WORDJS_ALLOWED_HOSTS": "www.example.com,devbox,10.1.1.1,localhost", "WORDJS_DEV_ORIGINS": "devbox" },
      "ownAddresses": []
    }
  },
  "policyEntries": [
    { "policy": "prod", "table": "aliases", "hostname": "www.example.com", "expect": { "scheme": "https", "mode": "serve", "signIn": true, "signInExplicit": false, "risk": null, "label": "www", "source": "admin" } },
    { "policy": "prod", "table": "aliases", "hostname": "ab12.ngrok-free.app", "expect": { "signIn": false, "risk": "tunnel", "source": "cli", "expiresAt": 1791763200000 }, "why": "R2: tunnel names are reassigned" },
    { "policy": "prod", "table": "aliases", "hostname": "192.168.1.50", "expect": { "scheme": "http", "port": 3000, "signIn": true, "signInExplicit": true, "risk": "ip" }, "why": "explicit opt-in wins" },
    { "policy": "prod", "table": "aliases", "hostname": "intranet.example.com", "expect": { "scheme": "http", "signIn": false, "risk": null }, "why": "http address on an https site" },
    { "policy": "prod", "table": "aliases", "hostname": "printer.local", "expect": { "scheme": "https", "signIn": false, "risk": "local" }, "why": "R2: .local is claimable over mDNS" },
    { "policy": "prod", "table": "aliases", "hostname": "legacy.example.net", "expect": { "mode": "redirect", "signIn": true } },
    { "policy": "prod", "table": "envHosts", "hostname": "ingress.example.net", "expect": { "scheme": null, "origin": null, "signIn": true, "source": "env" } },
    { "policy": "prod", "table": "envHosts", "hostname": "tls.example.net", "expect": { "scheme": "https", "origin": "https://tls.example.net", "signIn": true }, "why": "R12: a URL entry carries its scheme" },
    { "policy": "prod", "table": "envHosts", "hostname": "192.168.9.9", "expect": { "signIn": false, "risk": "ip" } }
  ],
  "classify": [
    { "policy": "prod", "host": "example.com", "cls": "canonical" },
    { "policy": "prod", "host": "EXAMPLE.com:443", "cls": "canonical" },
    { "policy": "prod", "host": "example.com.", "cls": "canonical" },
    { "policy": "prod", "host": "example.com:8443", "cls": "canonical", "why": "hostname match, port ignored" },
    { "policy": "prod", "host": "example.com", "proxied": true, "cls": "canonical" },
    { "policy": "prod", "host": "www.example.com", "cls": "alias" },
    { "policy": "prod", "host": "ab12.ngrok-free.app", "cls": "alias", "now": "2026-10-11T23:59:59Z" },
    { "policy": "prod", "host": "ab12.ngrok-free.app", "cls": "unknown", "reason": "expired-alias", "now": "2026-10-12T00:00:00Z" },
