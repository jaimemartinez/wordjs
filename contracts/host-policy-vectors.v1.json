    { "name": "trusted hop without XFH: its own Host", "req": { "remoteAddress": "127.0.0.1", "headers": { "host": "127.0.0.1:4000" } }, "expect": { "host": "127.0.0.1:4000", "hop": "local" } },
    { "name": "malformed Host is present, not absent", "req": { "remoteAddress": "203.0.113.9", "headers": { "host": "evil.example@localhost" } }, "expect": { "absent": false, "host": null } },
