    { "name": "operator proxy with a malformed Host: XFH unread, the Host is judged (400)", "trustProxy": "10.0.0.0/8", "req": { "remoteAddress": "10.1.2.3", "headers": { "host": "127.1", "x-forwarded-host": "example.com" } }, "expect": { "absent": false, "host": null, "hop": "operator", "source": "host" } },
