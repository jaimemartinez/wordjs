{
  "name": "wordjs-gateway",
  "version": "2.2.0",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "Dynamic Service Gateway for WordJS",
  "main": "gateway/src/index.js",
  "scripts": {
    "start": "concurrently -k -p \"[{name}]\" -n \"GATEWAY,BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" \"npm run prod:gateway\" \"npm run prod:backend\" \"npm run prod:frontend\"",
    "prod:gateway": "cd gateway && node src/index.js",
    "prod:backend": "cd backend && npm start",
    "prod:frontend": "cd frontend && npm start",
    "dev": "concurrently -k -p \"[{name}]\" -n \"GATEWAY,BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" \"npm run dev:gateway\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:gateway": "cd gateway && node src/index.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:mono": "cd backend && npm run build && cd ../frontend && npm run build",
    "start:mono": "node monolith.js prod",
    "dev:mono": "cd frontend && npm run predev && cd .. && node monolith.js dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../gateway && npm install && cd ../setup && npm install",
    "release:install": "node scripts/ci-install.mjs install --omit=dev",
    "install:gateway": "cd gateway && npm install",
    "install:setup": "cd setup && npm install",
    "setup": "node setup/index.js --install",
    "migrate": "node setup/index.js --migrate",
    "cluster": "node scripts/cluster.js",
    "node:join": "node scripts/node-join.js",
    "gate:separate": "node scripts/separate-mode-gate.mjs",
    "hooks:install": "node .githooks/install.mjs",
    "scan:secrets": "node .githooks/secret-scan.mjs --tracked",
    "bundle-release": "node scripts/make-release.js",
    "build:marketplace": "node backend/scripts/build-marketplace.js",
    "verify:marketplace": "node backend/scripts/verify-marketplace.js --rebuild",
    "verify:f0": "cd backend && npm run verify:f0",
    "verify:f1": "cd backend && npm run verify:f1",
    "generate:f2": "cd backend && npm run generate:f2",
    "verify:f2": "cd backend && npm run verify:f2",
    "verify:f3": "cd backend && npm run verify:f3",
    "verify:f4": "cd backend && npm run verify:f4",
    "generate:f5": "node scripts/generate-visual-contract.mjs",
    "verify:f5": "cd backend && npm run verify:f5",
    "verify:f6": "cd backend && npm run verify:f6",
    "perf:f0": "cd backend && npm run perf:f0",
    "perf:bench": "node scripts/perf-bench.mjs",
    "perf:bench:enforce": "node scripts/perf-bench.mjs --enforce --json",
    "ci:all": "node scripts/ci-install.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "concurrently": "^10.0.3",
    "helmet": "^8.3.0",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "puppeteer-core": "^25.9.0"
  }
}
